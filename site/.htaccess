# Furnist365 admin — routing + hardening for public_html/.
# See docs/php-admin-architecture.md section 8.
#
# Requires AllowOverride All (or at least FileInfo + Rewrite) at the Apache
# vhost level. Verify this took effect on the real account before relying
# on it (docs/php-admin-architecture.md section 11, Phase 0 / P-0).

RewriteEngine On

# The entire routing surface between Apache and PHP: every /api/admin/*
# request is handed to the one PHP front controller. QSA keeps the query
# string (?force=1, ?rev=, ?folder=, ?path=); L stops rule processing here.
RewriteRule ^api/admin/(.*)$ admin/api.php [QSA,L]

# Belt and braces: no dotfiles/dot-directories reachable by any URL (a stray
# .git, .env, .htaccess-adjacent file, etc). Not load-bearing on its own —
# the real fix is that nothing sensitive lives under this tree at all (see
# admin/.htaccess and the private/ split) — but cheap and worth keeping.
RewriteRule "(^|/)\." - [F]

Options -Indexes

# assets/js/data.js is regenerated by every admin Save and must never be
# served stale from a browser or intermediary cache once the admin panel is
# live. Requires mod_headers (standard on Apache/HestiaCP-style hosting).
<IfModule mod_headers.c>
    <FilesMatch "^data\.js$">
        Header set Cache-Control "no-store, max-age=0"
    </FilesMatch>

    # Uploaded brand/brands SVGs are scrubbed on upload (uploads.php), but a
    # blocklist scrubber is inherently incomplete -- this makes an SVG inert
    # even if one ever gets through. Static .svg files are served directly
    # by Apache (PHP is not in the path for a plain GET), so this header has
    # to be set here, not in api.php. docs/api-admin.md section 4.
    <FilesMatch "\.svg$">
        Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'"
    </FilesMatch>
</IfModule>
